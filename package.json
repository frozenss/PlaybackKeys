{
  "name": "playbackkeys",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Global keyboard shortcuts for YouTube, Udemy, Vimeo, Coursera, Bilibili, and browser videos.",
  "scripts": {
    "validate": "node scripts/validate-release.mjs",
    "package": "node scripts/validate-release.mjs --package",
    "release-notes": "node scripts/extract-changelog.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test:skip-intervals": "node scripts/skip-intervals-test.mjs",
    "test:options-skip-intervals-ui": "node scripts/options-skip-intervals-ui-test.mjs",
    "test:options-unbound-add-shortcuts-ui": "node scripts/options-unbound-add-shortcuts-ui-test.mjs",
    "test:onboarding-unbound-add-shortcuts-ui": "node scripts/onboarding-unbound-add-shortcuts-ui-test.mjs",
    "test:skip-burst": "node scripts/skip-burst-test.mjs",
    "test:ahk-bridge": "node scripts/ahk-bridge-test.mjs",
    "test:ahk-bridge-settings": "node scripts/ahk-bridge-settings-test.mjs",
    "test:bilibili-adapter": "node scripts/bilibili-adapter-test.mjs",
    "screenshots": "node scripts/generate-store-screenshots.mjs",
    "test:external-hotkey": "node scripts/external-hotkey-test.mjs"
